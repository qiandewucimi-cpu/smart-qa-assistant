# 复制为 scripts/.env 后填写真实值；不要在此文件中写入真实密钥。

# LLM-Wiki 本地 HTTP API Token
LLM_WIKI_API_TOKEN=你的token

# 智谱 API（仅截图 OCR / embedding 功能需要）
ZHIPU_API_KEY=你的智谱API_Key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 飞书机器人（仅 scripts/feishu_bot.py 需要）
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# 可选：LLM-Wiki app-state.json 的自定义位置。
# Windows 默认自动读取 %APPDATA%/com.llmwiki.app/app-state.json。
LLM_WIKI_STATE_FILE=

# 可选：机器人运行参数
BOT_WIKI_TIMEOUT=240
BOT_WIKI_RETRIES=2
BOT_SESSION_TTL=3600
BOT_CARD_MAX_CHARS=4500
BOT_TOP_K=15
